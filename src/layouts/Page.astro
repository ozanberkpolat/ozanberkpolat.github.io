---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
---
<Base title={frontmatter.title} current={frontmatter.current} mermaid={frontmatter.mermaid}>
  <main class="wrap">
    <div class="art" style="grid-template-columns:minmax(0,1fr)">
      <article><div class="prose"><slot /></div></article>
    </div>
  </main>
</Base>
